generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  lastActive   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teams     Team[]
  users     User[]
}

model Team {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  role              String             @default("USER")
  mfaEnabled        Boolean            @default(false)
  mfaSecret         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organizationId    String?
  teamId            String?
  accounts          Account[]
  alerts            Alert[]
  auditLogs         AuditLog[]
  identityVaults    IdentityVault[]
  invoices          Invoice[]
  monitoringJobs    MonitoringJob[]
  notifications     Notification[]
  payments          Payment[]
  protectedContents ProtectedContent[]
  sessions          Session[]
  socialAccounts    SocialAccount[]
  subscription      Subscription?
  uploads           Upload[]
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  team              Team?              @relation(fields: [teamId], references: [id])
  watermarks        Watermark[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ProtectedContent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  url         String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threats     Threat[]
}

model Threat {
  id                 String           @id @default(cuid())
  protectedContentId String
  sourceUrl          String
  severity           String           @default("LOW")
  status             String           @default("DETECTED")
  discoveredAt       DateTime         @default(now())
  resolvedAt         DateTime?
  protectedContent   ProtectedContent @relation(fields: [protectedContentId], references: [id], onDelete: Cascade)
}

model MonitoringJob {
  id        String    @id @default(cuid())
  userId    String
  targetUrl String
  frequency String    @default("DAILY")
  status    String    @default("ACTIVE")
  lastRunAt DateTime?
  nextRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  resource  String
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IdentityVault {
  id             String          @id @default(cuid())
  userId         String
  name           String
  description    String?
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  faceSignatures FaceSignature[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FaceSignature {
  id              String        @id @default(cuid())
  identityVaultId String
  signatureData   String
  sourceImageUrl  String?
  status          String        @default("ACTIVE")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  identityVault   IdentityVault @relation(fields: [identityVaultId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id               String            @id @default(cuid())
  userId           String
  platform         String
  handle           String
  profileUrl       String?
  status           String            @default("ACTIVE")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  publishSchedules PublishSchedule[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PublishSchedule {
  id              String        @id @default(cuid())
  socialAccountId String
  contentUrl      String
  scheduledAt     DateTime
  status          String        @default("SCHEDULED")
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
}

model Plan {
  id              String         @id @default(cuid())
  name            String         @unique
  priceMonthly    Float
  priceYearly     Float
  uploadLimit     Int
  monitoringLimit Int
  features        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  planTier             String    @default("FREE")
  planId               String?
  status               String    @default("ACTIVE")
  currentPeriodEnd     DateTime?
  paypalSubscriptionId String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  invoices             Invoice[]
  plan                 Plan?     @relation(fields: [planId], references: [id])
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  amount        Float
  currency      String   @default("USD")
  status        String   @default("COMPLETED")
  paymentMethod String
  transactionId String   @unique
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  amount         Float
  currency       String        @default("USD")
  status         String        @default("PAID")
  invoiceNumber  String        @unique
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Upload {
  id             String     @id @default(cuid())
  userId         String
  fileName       String
  fileSize       Int
  mimeType       String
  hash           String     @unique
  watermarkId    String?
  status         String     @default("PROCESSED")
  certificateUrl String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  watermark      Watermark? @relation(fields: [watermarkId], references: [id])
}

model Watermark {
  id        String   @id @default(cuid())
  userId    String
  type      String
  value     String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  uploads   Upload[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Waitlist {
  id             String     @id @default(cuid())
  name           String?
  email          String     @unique
  company        String?
  useCase        String?
  referralSource String?
  referralCode   String     @unique
  referredById   String?
  status         String     @default("PENDING")
  rank           Int        @default(0)
  createdAt      DateTime   @default(now())
  referredBy     Waitlist?  @relation("WaitlistReferral", fields: [referredById], references: [id], onDelete: Cascade)
  referrals      Waitlist[] @relation("WaitlistReferral")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SalesLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  useCase   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
