generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  lastActive   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  teams     Team[]
}

model Team {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // USER, ADMIN
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  teamId         String?
  team           Team?         @relation(fields: [teamId], references: [id])

  accounts           Account[]
  sessions           Session[]
  protectedContents  ProtectedContent[]
  monitoringJobs     MonitoringJob[]
  alerts             Alert[]
  auditLogs          AuditLog[]
  identityVaults     IdentityVault[]
  socialAccounts     SocialAccount[]
  subscription       Subscription?
  payments           Payment[]
  invoices           Invoice[]
  uploads            Upload[]
  watermarks         Watermark[]
  notifications      Notification[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ProtectedContent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  url         String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, COMPROMISED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threats    Threat[]
}

model Threat {
  id                 String   @id @default(cuid())
  protectedContentId String
  sourceUrl          String
  severity           String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  status             String   @default("DETECTED") // DETECTED, RESOLVED, IGNORED
  discoveredAt       DateTime @default(now())
  resolvedAt         DateTime?

  protectedContent ProtectedContent @relation(fields: [protectedContentId], references: [id], onDelete: Cascade)
}

model MonitoringJob {
  id          String   @id @default(cuid())
  userId      String
  targetUrl   String
  frequency   String   @default("DAILY") // HOURLY, DAILY, WEEKLY
  status      String   @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Alert {
  id          String   @id @default(cuid())
  userId      String
  type        String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  resource  String
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IdentityVault {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  faceSignatures  FaceSignature[]
}

model FaceSignature {
  id              String   @id @default(cuid())
  identityVaultId String
  signatureData   String   // Encrypted biometric data/embedding
  sourceImageUrl  String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  identityVault IdentityVault @relation(fields: [identityVaultId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id           String   @id @default(cuid())
  userId       String
  platform     String   // YOUTUBE, INSTAGRAM, TIKTOK, TWITTER
  handle       String
  profileUrl   String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishSchedules  PublishSchedule[]
}

model PublishSchedule {
  id              String   @id @default(cuid())
  socialAccountId String
  contentUrl      String
  scheduledAt     DateTime
  status          String   @default("SCHEDULED") // SCHEDULED, PUBLISHED, FAILED
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
}

model Plan {
  id               String   @id @default(cuid())
  name             String   @unique // FREE, CREATOR, PROFESSIONAL, ENTERPRISE
  priceMonthly     Float
  priceYearly      Float
  uploadLimit      Int
  monitoringLimit  Int
  features         String   // JSON string of features
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions    Subscription[]
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  planTier             String    @default("FREE") // FREE, CREATOR, PROFESSIONAL, ENTERPRISE
  planId               String?
  status               String    @default("ACTIVE") // ACTIVE, CANCELED, PAST_DUE
  currentPeriodEnd     DateTime?
  paypalSubscriptionId String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id])

  invoices Invoice[]
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  amount        Float
  currency      String   @default("USD")
  status        String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  paymentMethod String   // PAYPAL, UPI, CRYPTO
  transactionId String   @unique
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String        @id @default(cuid())
  userId         String
  subscriptionId String?
  amount         Float
  currency       String        @default("USD")
  status         String        @default("PAID") // PAID, UNPAID, VOID
  invoiceNumber  String        @unique
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
}

model Upload {
  id             String     @id @default(cuid())
  userId         String
  fileName       String
  fileSize       Int
  mimeType       String
  hash           String     @unique
  watermarkId    String?
  status         String     @default("PROCESSED") // PROCESSING, PROCESSED, FAILED
  certificateUrl String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  watermark Watermark? @relation(fields: [watermarkId], references: [id], onDelete: SetNull)
}

model Watermark {
  id        String   @id @default(cuid())
  userId    String
  type      String   // TEXT, IMAGE, CRYPTO
  value     String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploads Upload[]
}

model Waitlist {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  company        String?
  useCase        String?
  referralSource String?
  referralCode   String    @unique
  referredById   String?
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rank           Int       @default(0)
  createdAt      DateTime  @default(now())

  referredBy Waitlist?  @relation("WaitlistReferral", fields: [referredById], references: [id], onDelete: Cascade)
  referrals  Waitlist[] @relation("WaitlistReferral")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   // THREAT, BILLING, SECURITY, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SalesLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  useCase   String?
  status    String   @default("PENDING") // PENDING, CONTACTED, NEGOTIATING, WON, LOST
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
